# Bootstrap configuration only. Everything operational lives in the ih_settings
# table and is editable from the admin UI at runtime.

DATABASE_URL=mysql://claude:CHANGEME@127.0.0.1:3306/haloid
HALOID_BIND=127.0.0.1:8080
HALOID_DATA_DIR=./data
HALOID_LOG=info,haloid=debug,sqlx=warn
# HALOID_LOG_FORMAT=json
# HALOID_DISABLE_JOBS=1
# HALOID_ALTCHA_SECRET=     # generated at startup when unset
# HALOID_ALTCHA_COST=1      # tests only: cheapens the sign-in proof-of-work

# Any setting can be pinned here, above the database: HALOID_ + its key
# upper-cased, dots as underscores. A pinned setting is read-only in the admin
# UI. For example:
# HALOID_SITE_BASE_URL=https://img.example.com
# HALOID_UPLOADS_GUESTS_ENABLED=false

# Storage credentials are env-only, keyed by the storage's name in ih_storages.
# A database dump must never be a credential leak.
# HALOID_STORAGE_MAIN_ACCESS_KEY=
# HALOID_STORAGE_MAIN_SECRET_KEY=

# Integration tests: a MariaDB server URL with no database component. Each
# test creates and drops its own database; without this they skip.
# TEST_DATABASE_URL=mysql://claude:CHANGEME@127.0.0.1:3306

# The S3 storage suite: any S3-compatible server. Without these it skips.
#   docker run -d -p 127.0.0.1:9000:9000 -e RUSTFS_ACCESS_KEY=haloid \
#     -e RUSTFS_SECRET_KEY=haloid-s3-secret rustfs/rustfs
# TEST_S3_ENDPOINT=http://127.0.0.1:9000
# TEST_S3_ACCESS_KEY=haloid
# TEST_S3_SECRET_KEY=haloid-s3-secret
